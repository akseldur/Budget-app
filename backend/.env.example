DATABASE_URL=postgresql+psycopg://budsjett:budsjett@localhost:5432/budsjett

# Enable Banking (PSD2). Application opprettet i sandbox-miljø på enablebanking.com.
# Privat nøkkel lastes ALDRI opp noe sted - kun referert via lokal filsti.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enablebanking_private_key.pem
ENABLE_BANKING_ENVIRONMENT=sandbox
ENABLE_BANKING_REDIRECT_URL=http://localhost:8000/auth/enablebanking/callback

FINNHUB_API_KEY=
